{
  "name": "mct-it-portal-backend",
  "version": "1.0.0",
  "description": "MCT IT Portal - Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:generate:production": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:validate:production": "DATABASE_URL=postgresql://schema-validation:unused@localhost:5432/schema_validation prisma validate --schema prisma/postgresql/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:migrate:production": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "generate:formdata-types": "node scripts/generate-formdata-types.js",
    "backup:check": "./scripts/backup-production.sh --check",
    "backup:production": "./scripts/backup-production.sh",
    "restore:verify": "./scripts/restore-production.sh",
    "sla:run": "node scripts/run-sla-notifications.js",
    "lint": "eslint src --max-warnings=50",
    "test:integration": "node test/run-integration-tests.js",
    "test:money": "node test/money.test.js",
    "test:reporting": "node test/reporting.test.js",
    "test:unit": "node test/auth-rbac.test.js && node test/money.test.js && node test/logger.test.js && node test/sla.test.js && node test/sla-notification.test.js && node test/request-constants.test.js && node test/request-route-contract.test.js && node test/request-shared.test.js && node test/reporting.test.js && node test/pdf-signature.test.js && node test/delegation-authority.test.js && node test/upload-route.test.js && node test/formData.schemas.test.js && node test/formData.contract-sync.test.js && node test/organization.config.test.js && node test/refresh-token.test.js && node test/validation-schemas.test.js && node test/integration-enhancements.test.js",
    "test:schemas": "npm run db:validate && npm run db:validate:production",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "nodemon": "^3.1.2",
    "prettier": "^3.0.0",
    "prisma": "^5.14.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
