# ─── Secrets & Environnement ────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Uploads & Documents métier ─────────────────────────────────────────────
# Ne jamais versionner les pièces jointes, PDF ou fichiers uploadés par les utilisateurs.
# En production, ces fichiers doivent être sur un volume persistant ou un stockage objet.
backend/uploads/
backend/output/
backend/tmp/
**/uploads/*.pdf
**/uploads/*.docx
**/uploads/*.xlsx
**/uploads/*.png
**/uploads/*.jpg
**/uploads/*.jpeg

# Conserver les fixtures de test anonymisées dans test/fixtures/ uniquement
# backend/test/fixtures/ — ne pas exclure ce dossier

# ─── Base de données locale ──────────────────────────────────────────────────
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-shm
backend/prisma/*.db-wal
# Base de test éphémère (générée par test_integration.js)
/tmp/mct-test-*.db

# ─── Dépendances Node.js ─────────────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ─── Build Frontend ──────────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/
frontend/build/

# ─── Rapports de tests ───────────────────────────────────────────────────────
# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/
**/playwright-report/

# Coverage
coverage/
backend/coverage/
frontend/coverage/
*.lcov

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Caches ──────────────────────────────────────────────────────────────────
.npm/
.eslintcache
.cache/
*.tsbuildinfo

# ─── OS & Éditeurs ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
